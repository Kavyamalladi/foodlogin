# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_public_key_id
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Must match Razorpay Dashboard → Webhooks → your endpoint → Webhook secret (set identically on Vercel)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Set to "true" to load @vercel/analytics (uses Web Analytics event quota on Hobby)
# NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=true

# App
ADMIN_EMAIL=your_admin_supabase_login_email
DELIVERY_CHARGE=100
NEXT_PUBLIC_WHATSAPP_NUMBER=your_whatsapp_number
# Optional footer details (hidden when unset)
# NEXT_PUBLIC_FSSAI_NUMBER=your_14_digit_fssai_licence_number
